# Copiar a .env.production en el servidor. Nunca subir este archivo como .env.production.
DB_HOST=127.0.0.1
DB_USER=usuario_produccion
DB_PASS=CAMBIAR_PASSWORD_DB
DB_NAME=restocloud_production
APP_ENV=production
RUN_MIGRATIONS=0
# Las tablas deben estar migradas. El primer superadmin se crea también con
# RUN_MIGRATIONS=0 si users está vacío. Nunca se reemplazan cuentas existentes.
INITIAL_ADMIN_EMAIL=admin@restocloud.com
INITIAL_ADMIN_PASSWORD=CAMBIAR_PASSWORD_INICIAL
RESTOCLOUD_PRINT_TOKEN=CAMBIAR_TOKEN_IMPRESION
WS_BIND_HOST=127.0.0.1
