# RestoCloud — Variables de Entorno
# Copia este archivo a .env y edita los valores para tu servidor.

# Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=pos_pension

# Environment: 'development' o 'production'
APP_ENV=production

# En development, las migraciones se ejecutan automáticamente.
# En production, ejecuta: php migrate.php --force
RUN_MIGRATIONS=0
CHATBOT_SIMULATOR_ENABLED=0

# LLM provider: groq | ollama | gemini
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Cada número debe configurarse por tenant/sucursal como whatsapp_phone_id.
# El webhook rechaza mensajes cuyo número no pueda resolverse.
