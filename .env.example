# RestoCloud — Variables de Entorno
# Copia este archivo a .env y edita los valores para tu servidor.

# Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=pos_pension

# Environment: 'development' o 'production'
APP_ENV=production

# En development, las migraciones se ejecutan automáticamente.
# En production, ejecuta: php migrate.php --force
RUN_MIGRATIONS=0
